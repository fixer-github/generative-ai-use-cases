{
  "name": "generative-ai-use-cases",
  "private": true,
  "version": "4.3.2",
  "scripts": {
    "lint": "run-s custom-lint:build web:lint cdk:lint cdk:lambda-build-dryrun",
    "lint:fix": "run-s custom-lint:build web:lint:fix cdk:lint cdk:lambda-build-dryrun",
    "test": "run-s web:test",
    "format": "prettier --write .",
    "web:devw": "source ./setup-env.sh ${npm_config_env} && VITE_APP_VERSION=${npm_package_version} pnpm -F web dev",
    "web:devww": "powershell ./web_devw_win.ps1",
    "web:dev": "VITE_APP_VERSION=${npm_package_version} pnpm -F web dev",
    "web:build": "VITE_APP_VERSION=${npm_package_version} pnpm -F web build --",
    "web:build:analyze": "VITE_APP_VERSION=${npm_package_version} pnpm -F web build -- --mode analyze",
    "web:lint": "pnpm -F web lint",
    "web:lint:fix": "pnpm -F web lint:fix",
    "web:test": "pnpm -F web test",
    "cdk:deploy": "pnpm -F cdk cdk deploy -- --all",
    "cdk:deploy:quick": "pnpm -F cdk cdk deploy -- --all --asset-parallelism --asset-prebuild=false --concurrency 3 --method=direct --require-approval never --force",
    "cdk:deploy:quick:hotswap": "pnpm -F cdk cdk deploy -- --all --asset-parallelism --asset-prebuild=false --concurrency 3 --method=direct --require-approval never --force --hotswap",
    "cdk:deploy:synth": "pnpm -F cdk cdk synth -- --all",
    "cdk:tenant:deploy": "pnpm -F cdk cdk -- --app 'npx ts-node --prefer-ts-exts bin/generative-ai-use-cases-tenant.ts' deploy --all",
    "cdk:tenant:list": "pnpm -F cdk cdk -- --app 'npx ts-node --prefer-ts-exts bin/generative-ai-use-cases-tenant.ts' list",
    "cdk:tenant:synth": "pnpm -F cdk cdk -- --app 'npx ts-node --prefer-ts-exts bin/generative-ai-use-cases-tenant.ts' synth",
    "cdk:tenant:diff": "pnpm -F cdk cdk -- --app 'npx ts-node --prefer-ts-exts bin/generative-ai-use-cases-tenant.ts' diff",
    "cdk:tenant:destroy": "pnpm -F cdk cdk -- --app 'npx ts-node --prefer-ts-exts bin/generative-ai-use-cases-tenant.ts' destroy --all",
    "cdk:destroy": "pnpm -F cdk cdk destroy -- --all",
    "cdk:lint": "pnpm -F cdk lint",
    "cdk:lambda-build-dryrun": "pnpm -F cdk lambda-build-dryrun",
    "cdk:test": "pnpm -F cdk test",
    "cdk:test:update-snapshot": "pnpm -F cdk test -- --update-snapshot",
    "cdk:watch": "pnpm -F cdk cdk watch",
    "extension:ci": "pnpm i --frozen-lockfile -C browser-extension",
    "extension:dev": "cd browser-extension && pnpm dev",
    "extension:devw": "source ./setup-env.sh && cd browser-extension && pnpm dev",
    "extension:build": "cd browser-extension && pnpm build",
    "extension:buildw": "source ./setup-env.sh && cd browser-extension && pnpm build",
    "extension:lint": "prettier --write browser-extension/. && cd browser-extension",
    "custom-lint:build": "pnpm -F eslint-plugin-i18nhelper build",
    "docs:dev": "mkdocs serve",
    "docs:build": "mkdocs build",
    "docs:gh-deploy": "mkdocs gh-deploy --"
  },
  "devDependencies": {
    "@shopify/eslint-plugin": "50.0.0",
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "eslint": "9.35.0",
    "eslint-plugin-i18nhelper": "workspace:*",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-plugin-tailwindcss": "3.18.2",
    "eslint-plugin-yml": "1.18.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14"
  }
}
