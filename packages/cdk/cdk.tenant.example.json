{
  "context": {
    // ========================================
    // TENANT-SPECIFIC PARAMETERS (REQUIRED)
    // ========================================

    "tenantId": "YOUR_TENANT_ID",
    "environment": "dev",
    "tenantRegion": "us-east-1",

    // =============================================
    // CONTROL PLANE PARAMETERS (from main account)
    // =============================================
    // These parameters are from the main account where GenerativeAiUseCasesStack is deployed

    "controlPlane": {
      // Main account ID (where TenantManager is deployed)
      "account": "111111111111",
      "region": "us-east-1",

      // From TenantManager deployment outputs (check main stack outputs)
      // Table name format: "Tenants-{environment}"
      "tenantsTableName": "Tenants-dev",

      // From TenantManager deployment outputs
      // Lambda ARN format: "arn:aws:lambda:{region}:{account}:function:TenantRegistration-{environment}"
      "registrationLambdaArn": "arn:aws:lambda:us-east-1:111111111111:function:TenantRegistration-dev",

      // From main stack Cognito deployment (check GenerativeAiUseCasesStack outputs)
      "userPoolId": "us-east-1_EXAMPLE123",
      "identityPoolId": "us-east-1:12345678-1234-1234-1234-123456789012",
      "userPoolClientId": "1234567890abcdefghijklmnop"
    },

    // ===============================
    // DEPLOYMENT OPTIONS (optional)
    // ===============================

    // Set to true only for development/testing - DESTROYS resources on stack deletion
    "enableAutoDelete": false
  }
}
