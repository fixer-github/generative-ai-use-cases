/**
 * SpiceDB Authorization Schema for GenAI Multi-Tenant Application
 * 認可スキーマ定義
 *
 * This schema defines permissions for:
 * - Tenant membership and administration
 * - Plan-based access control
 * - Resource-level permissions (conversations, documents)
 * - Usecase and model access with quota enforcement
 */

// ============================================================================
// Core Entities
// コアエンティティ
// ============================================================================

/** User - represents a system user */
definition user {}

/** Tenant - multi-tenant organization */
definition tenant {
    /** Users who are members of this tenant */
    relation member: user

    /** Users who are administrators of this tenant */
    relation admin: user

    /** The plan this tenant subscribes to */
    relation subscribed_plan: plan

    /** Permission to view tenant resources */
    permission view = member + admin

    /** Permission to manage tenant (admin only) */
    permission manage = admin
}

/** Plan - subscription tier (free, pro, enterprise) */
definition plan {
    /** Tenants subscribing to this plan */
    relation subscriber: tenant

    /** Usecases allowed by this plan */
    relation allowed_usecase: usecase

    /** Models allowed by this plan */
    relation allowed_model: model

    /** Permission to use the plan */
    permission use = subscriber
}

// ============================================================================
// Resource Entities
// リソースエンティティ
// ============================================================================

/** Conversation - chat conversation resource */
definition conversation {
    /** Tenant owning this conversation */
    relation tenant: tenant

    /** User who created/owns this conversation */
    relation owner: user

    /** Users with explicit view permission */
    relation viewer: user

    /** Permission to view conversation */
    permission view = viewer + owner + tenant->member

    /** Permission to edit conversation */
    permission edit = owner

    /** Permission to delete conversation */
    permission delete = owner + tenant->admin
}

/** Document - RAG document resource */
definition document {
    /** Tenant owning this document */
    relation tenant: tenant

    /** User who owns this document */
    relation owner: user

    /** User who uploaded this document */
    relation uploader: user

    /** Users with explicit view permission */
    relation viewer: user

    /** Permission to view document */
    permission view = viewer + owner + tenant->member

    /** Permission to upload documents */
    permission upload = tenant->member

    /** Permission to delete document */
    permission delete = owner + tenant->admin
}

// ============================================================================
// Usecase & Model Access
// ユースケース・モデルアクセス
// ============================================================================

/** Usecase - GenAI usecase (chat, rag, translation, etc.) */
definition usecase {
    /** Plans that allow this usecase */
    relation allowed_by_plan: plan

    /** Permission to execute this usecase */
    permission execute = allowed_by_plan->subscriber->member
}

/** Model - AI model (claude-3-sonnet, gpt-4, etc.) */
definition model {
    /** Plans that allow this model */
    relation allowed_by_plan: plan

    /** Permission to execute (use) this model */
    permission execute = allowed_by_plan->subscriber->member
}

// ============================================================================
// Quota-Aware Model Access
// クォータ対応モデルアクセス
// ============================================================================

/** Caveat for quota checking */
caveat quota_available(current_usage int, quota_limit int) {
    current_usage < quota_limit
}

/** Model with quota enforcement via caveat */
definition model_with_quota {
    /** Plans that allow this model */
    relation allowed_by_plan: plan

    /** User requesting access */
    relation user: user

    /**
     * Permission to execute with quota check
     * Requires both plan permission AND quota availability
     */
    permission execute = (user & allowed_by_plan->subscriber->member) if quota_available
}

// ============================================================================
// Admin Operations
// 管理操作
// ============================================================================

/** Admin operation - tenant management actions */
definition admin_operation {
    /** Users allowed to perform this operation */
    relation allowed_admin: user

    /** Permission to execute admin operation */
    permission execute = allowed_admin
}

// ============================================================================
// Usage Examples
// 使用例
// ============================================================================

/**
 * Example relationships:
 *
 * # Tenant membership
 * tenant:acme#member@user:alice
 * tenant:acme#admin@user:bob
 * tenant:acme#subscribed_plan@plan:pro
 *
 * # Plan permissions
 * plan:pro#subscriber@tenant:acme
 * plan:pro#allowed_usecase@usecase:chat
 * plan:pro#allowed_model@model:claude-3-sonnet
 *
 * # Resource ownership
 * conversation:123#tenant@tenant:acme
 * conversation:123#owner@user:alice
 * conversation:123#viewer@user:charlie
 *
 * # Model with quota
 * model_with_quota:claude-3-sonnet#allowed_by_plan@plan:pro
 * model_with_quota:claude-3-sonnet#user@user:alice[quota_available:{"current_usage":8,"quota_limit":50}]
 *
 * Permission checks:
 *
 * # Can user view conversation?
 * check conversation:123 view user:alice
 *
 * # Can user execute usecase?
 * check usecase:chat execute user:alice
 *
 * # Can user use model (with quota)?
 * check model_with_quota:claude-3-sonnet execute user:alice --caveat-context '{"current_usage":8,"quota_limit":50}'
 */
